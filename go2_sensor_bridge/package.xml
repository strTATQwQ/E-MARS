  <description>Fail-closed standard ROS 2 bridge for Go2 LiDAR, RGB, IMU and safety clouds.</description>
  <maintainer email="noreply@example.invalid">InternNav T4</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_python</buildtool_depend>
