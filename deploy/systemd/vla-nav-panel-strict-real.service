[Unit]
Description=VLA Nav Panel strict real-Go2 telemetry and mission ingress
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/E-MARS/frontend
EnvironmentFile=%h/.config/vla-nav-panel/strict-real.env
ExecStart=%h/E-MARS/frontend/scripts/run_ros_frontend.sh %h/E-MARS/configs/strict_real_go2.yaml %h/.local/state/e-mars/strict_real_go2
Restart=on-failure
RestartSec=3
TimeoutStopSec=15
KillMode=control-group
NoNewPrivileges=true

[Install]
WantedBy=default.target
