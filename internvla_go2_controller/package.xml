<?xml version="1.0"?>
<package format="3">
  <name>internvla_go2_controller</name>
  <version>0.1.0</version>
  <description>Continuous Isaac Go2 controller bridge for InternVLA and Nav2.</description>
  <maintainer email="noreply@example.invalid">InternNav T3</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>internvla_ros2_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <test_depend>python3-pytest</test_depend>
  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
